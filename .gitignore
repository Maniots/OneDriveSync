# IDE
.vscode/
.idea/

# Application runtime data - keep the folders, ignore their contents
logs/*
!logs/.gitkeep
backups/*
!backups/.gitkeep
data/*
!data/.gitkeep

# OS noise
Thumbs.db
.DS_Store

# Auto-generated by Setup-ScheduledTasks.ps1
RunHidden.vbs

# Runtime single-instance lock file
onedrive_pcsync.lock
onedrive_pcsync_shutdown_monitor.lock
*.history.sqlite3
*.history.sqlite3-journal
*.history.sqlite3-wal
*.history.sqlite3-shm

# claude APIs
.claude/
settings.local.json
